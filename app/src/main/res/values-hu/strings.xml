  <!--App Introduction-->
  <string name="app_intro">OSMTracker for Android™ – bemutatkozás</string>
  <!--Intro - slide1-->
  <string name="app_intro_slide1_title">Üdvözöl az OSMTracker for Android™ 👋</string>
  <string name="app_intro_slide1_description">Ez az alkalmazás szabad szoftver, amely tiszteletben tartja a szabadságodat!</string>
  <!--Intro - slide What's new-->
  <string name="app_intro_slide_whats_new_title">Mik az újdonságai ennek a verziónak?</string>
  <string name="app_intro_slide_whats_new_description">Mostantól jegyzeteket is fel lehet tölteni OSM-be, és ismét elérhetőek a CyclOSM, valamint az OpenTopo térképcsempék. Jó szórakozást!</string>
  <!--Intro - slide2-->
  <string name="app_intro_slide2_title">Jó nyomvonalrögzítést! 🗺 😎</string>
